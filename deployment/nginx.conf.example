server {
    listen 80;
    server_name agrotikos.com www.agrotikos.com;
    return 301 https://agrotikos.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name agrotikos.com www.agrotikos.com;

    # Configure certificados TLS en el servidor.
    # ssl_certificate /etc/letsencrypt/live/agrotikos.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/agrotikos.com/privkey.pem;

    client_max_body_size 2m;

    location /static/ {
        alias /srv/web_agrotikos/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
