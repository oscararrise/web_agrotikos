[Unit]
Description=AgroTikos Django Gunicorn
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/web_agrotikos
Environment="DJANGO_DEBUG=False"
Environment="DJANGO_ALLOWED_HOSTS=agrotikos.com,www.agrotikos.com"
Environment="DJANGO_CSRF_TRUSTED_ORIGINS=https://agrotikos.com,https://www.agrotikos.com"
EnvironmentFile=/etc/agrotikos/agrotikos.env
ExecStart=/srv/web_agrotikos/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60 --access-logfile - --error-logfile -
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
